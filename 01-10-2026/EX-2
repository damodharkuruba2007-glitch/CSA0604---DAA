#include <iostream>
#include <vector>
#include <unordered_set>
using namespace std;

int main() {
    vector<int> nums1 = {2, 3, 2};
    vector<int> nums2 = {1, 2};

    unordered_set<int> s1(nums1.begin(), nums1.end());
    unordered_set<int> s2(nums2.begin(), nums2.end());

    int answer1 = 0, answer2 = 0;

    for (int x : nums1) {
        if (s2.count(x))
            answer1++;
    }

    for (int x : nums2) {
        if (s1.count(x))
            answer2++;
    }

    cout << "[" << answer1 << ", " << answer2 << "]" << endl;

    return 0;
}
