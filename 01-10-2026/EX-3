#include <stdio.h>

int main() {
    int nums[] = {1, 2, 1};
    int n = 3, sum = 0;

    for (int i = 0; i < n; i++) {
        int count = 0;

        for (int j = i; j < n; j++) {
            int found = 0;

            for (int k = i; k < j; k++) {
                if (nums[k] == nums[j]) {
                    found = 1;
                    break;
                }
            }

            if (found == 0)
                count++;

            sum += count * count;
        }
    }

    printf("Output: %d\n", sum);
    return 0;
}
