#include <stdio.h>

int main() {
    int a[] = {3, 7, 3, 5, 2, 5, 9, 2};
    int n = 8;
    int unique[8];
    int count = 0;

    for (int i = 0; i < n; i++) {
        int found = 0;

        for (int j = 0; j < count; j++) {
            if (a[i] == unique[j]) {
                found = 1;
                break;
            }
        }

        if (found == 0) {
            unique[count] = a[i];
            count++;
        }
    }

    printf("Unique elements: [");
    for (int i = 0; i < count; i++) {
        printf("%d", unique[i]);
        if (i < count - 1)
            printf(", ");
    }
    printf("]\n");

    return 0;
}
