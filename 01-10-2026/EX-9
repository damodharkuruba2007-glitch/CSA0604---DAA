#include <stdio.h>

int main() {
    int arr[] = {3, 4, 6, 9, 10, 8, 9, 30};
    int n = 8;
    int key = 10;

    int low = 0, high = n - 1;
    int found = -1;

    while (low <= high) {
        int mid = (low + high) / 2;

        if (arr[mid] == key) {
            found = mid;
            break;
        }
        else if (arr[mid] < key) {
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }

    if (found != -1)
        printf("Element %d is found at position %d\n", key, found + 1);
    else
        printf("Element %d is not found\n", key);

    return 0;
}
